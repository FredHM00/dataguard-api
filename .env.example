# Copie para `.env` e ajuste:  cp .env.example .env
# NUNCA commite o `.env` (esta no .gitignore).

POSTGRES_USER=dataguard
# Senha SOMENTE para desenvolvimento local. Troque em qualquer ambiente
# compartilhado e nunca reutilize em producao.
POSTGRES_PASSWORD=dataguard-dev-only
POSTGRES_DB=dataguard

# JWT (obrigatorio a partir da Etapa 3; sem ele a app nem importa).
# Gerar um novo:  openssl rand -base64 48
JWT_SECRET_KEY=

# Fernet (obrigatorio a partir da Etapa 4; sem ele a app nem importa).
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RISCOS: perder a chave = perder as observacoes cifradas (irreversivel);
# trocar a chave sem re-cifrar = registros antigos ilegiveis. Backup e rotacao
# exigem procedimento proprio (fora do escopo deste projeto educacional).
# FERNET_KEY=

# Rate limit (Etapa 8): memoria local por padrao; Redis para multiplos
# workers/maquinas. O Compose ja sobe o Redis; descomente para usa-lo:
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379
